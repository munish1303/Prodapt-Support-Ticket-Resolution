# Copy to .env and fill in. Never commit .env.

# Local runs (outside Docker). docker-compose overrides this for the api container.
DATABASE_URL=postgresql+asyncpg://support:support@localhost:5432/support

# --- LLM: any OpenAI-compatible endpoint ---------------------------------
# Groq (free tier): https://console.groq.com/keys  (list models: GET /openai/v1/models)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=qwen/qwen3.8-27b
LLM_API_KEY=

# Google Gemini (free tier) alternative:
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-2.0-flash
# LLM_API_KEY=

# Without a key the service runs in extractive mode (no LLM; cited steps are
# selected from retrieved sources). Force it explicitly with:
# LLM_PROVIDER=extractive

# Thresholds are provisional; see app/config.py for the full list.
# LLM_FORCE_IPV4=true     # if LLM calls fail with connection resets on a broken IPv6 network
# USE_RERANKING=false
# DECISION_RESOLVE_THRESHOLD=0.75
# DECISION_REVIEW_THRESHOLD=0.55
